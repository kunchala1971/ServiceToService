# ===================================================================
# Git Ignore Configuration for Spring Boot & Maven Projects
# ===================================================================

# Compiled class files
*.class

# Log files
*.log
logs/
**/logs/

# Package Files & Build Directories
target/
**/target/
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# Standalone Portable Maven Tool
apache-maven-*/

# Virtual Machine crash logs
hs_err_pid*
replay_pid*

# ===================================================================
# IDE and Editor Files
# ===================================================================

# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# Eclipse
.apt_generated
.classpath
.factorypath
.project
.settings/
.springBeans
.sts4-cache

# Visual Studio Code
.vscode/

# NetBeans
/nbproject/private/
/nbbuild/
/dist/
/nbproject/load-impl.xml

# ===================================================================
# OS Generated Files
# ===================================================================
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
